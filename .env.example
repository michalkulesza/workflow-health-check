# Server-only backend configuration. Use a disposable PostgreSQL database locally.
DATABASE_URL=postgresql://workflow:change-me@127.0.0.1:55432/workflow_spike
# Generate a random secret of at least 32 characters; never use this placeholder.
PAYLOAD_SECRET=
# Only enable on a disposable development database. Never enable in production.
PAYLOAD_SCHEMA_PUSH=false
# Server-only Gemini configuration. The model is pinned in the published AI evaluation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Server-only report-notification delivery and private-link hashing.
APP_ORIGIN=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=
REPORT_TOKEN_PEPPER=
# Docker Compose database and reverse-proxy settings. Use a verified domain in
# production; never commit a filled production environment file.
POSTGRES_DB=workflow_spike
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me
APP_DOMAIN=localhost
# An absolute directory outside the repository for encrypted, off-host copies.
BACKUP_DIRECTORY=
# Required only for an isolated restore rehearsal. This action is destructive.
RESTORE_DATABASE_URL=
ALLOW_DATABASE_RESTORE=false
# Retention is dry-run by default and only purges after policy approval.
RETENTION_PURGE_APPROVED=false
# Temporary bootstrap credentials; remove after creating the first admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Browser smoke tests are intentionally opt-in. The ID below is the published
# foundation questionnaire created by `npm run db:seed` in a disposable database.
E2E_QUESTIONNAIRE_ID=5dc13945-9cb8-4e6b-b504-187c885e0e34
# Integration tests require a disposable database and use controlled provider
# responses only. Do not set these for development or production processes.
RUN_INTEGRATION_TESTS=false
ASSESSMENT_TEST_PROVIDER_SCENARIO=
# Browser tests require either a local production build or an explicit preview.
# E2E_LOCAL_PREVIEW starts the configured local target; E2E_BASE_URL targets a
# disposable external preview. Leave both unset outside browser-test runs.
E2E_LOCAL_PREVIEW=false
E2E_BASE_URL=
E2E_IGNORE_HTTPS_ERRORS=false
E2E_BROWSER_EXECUTABLE=
# The full journey writes fictional assessment data. Keep it disabled unless
# the target is a disposable preview. Clarification testing depends on it.
RUN_PREVIEW_JOURNEY=false
RUN_PREVIEW_CLARIFICATION=false
