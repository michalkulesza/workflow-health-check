# Safe, client-visible prototype flag. Enable only when reviewing scoring.
NEXT_PUBLIC_SCORING_DEBUG=false

# Server-only backend compatibility spike. Use a disposable PostgreSQL database.
DATABASE_URL=postgresql://workflow:change-me@127.0.0.1:55432/workflow_spike
# Generate a random secret of at least 32 characters; never use this placeholder.
PAYLOAD_SECRET=
# Only enable on a disposable development database. Never enable in production.
PAYLOAD_SCHEMA_PUSH=false
# Temporary bootstrap credentials; remove after creating the first admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
