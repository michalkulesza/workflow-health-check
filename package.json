{
  "name": "workflow-health-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "db:migrate": "payload migrate",
    "db:migration:create": "payload migrate:create",
    "db:backup": "tsx scripts/backupDatabase.ts",
    "db:restore": "tsx scripts/restoreDatabase.ts",
    "db:seed": "tsx scripts/seedFoundation.ts",
    "db:verify:publication": "tsx scripts/verifyPublication.ts",
    "admin:bootstrap": "tsx scripts/bootstrapAdmin.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "worker:health": "tsx scripts/workerHealthcheck.ts",
    "retention:purge": "tsx scripts/purgeRetention.ts",
    "job:fixture": "tsx scripts/fixtureJob.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@hookform/resolvers": "^5.2.1",
    "@next/env": "16.3.4",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "graphql": "16.11.0",
    "next": "^16.3.4",
    "payload": "3.89.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
